# Copie para .env.local e preencha com os dados do projeto no Supabase.

# Usadas pelo app. Ficam visíveis dentro do APK.
# Project Settings > API: URL do projeto e a publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usada pelo drizzle-kit para aplicar as migrations. Nunca vai para o app.
# Connect > Session pooler (porta 5432), com a senha do banco.
DATABASE_URL=
